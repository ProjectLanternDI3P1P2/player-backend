{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=player;Username=player"
  },
  "Grpc": {
    "Dungeon": {
      "Address": "http://dungeon:8081",
      "TimeoutSeconds": 5
    },
    "Resilience": {
      "Retry": {
        "MaxAttempts": 1
      },
      "CircuitBreaker": {
        "FailureThreshold": 5,
        "BreakDurationSeconds": 30
      }
    }
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "player.events",
    "QueueName": "player.events.v1",
    "PrefetchCount": 16,
    "DeadLetterExchangeName": "lantern.dead-letter",
    "DeadLetterQueueName": "player.events.v1.dead",
    "Subscriptions": [
      {
        "ExchangeName": "dungeon.events",
        "RoutingKey": "dungeon.dungeon-run-ended.v1"
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%/health%' and (StatusCode is null or StatusCode = 200) or (RequestPath like '%/metrics%' and (StatusCode is null or StatusCode = 200))"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level}] {Scope} {Message:lj} <s:{SourceContext}> [level:{level}]{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
