<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <!-- x-release-please-version -->
    <PackageId>Player.Contracts</PackageId>
    <Description>Public Protocol Buffers and generated gRPC types exposed by the Player service.</Description>
    <PackageTags>grpc;protobuf;contracts</PackageTags>
    <PackageProjectUrl>https://github.com/ProjectLanternDI3P1P2/player-backend</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProjectLanternDI3P1P2/player-backend.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/message_envelope_v1.proto" GrpcServices="None" />
    <None Include="Protos/message_envelope_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
