<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Contract packages the other services publish (ADR-GLOB-007). -->
    <add key="github" value="https://nuget.pkg.github.com/ProjectLanternDI3P1P2/index.json" />
  </packageSources>

  <!-- Each package comes from one source only: a public package cannot shadow a contract. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Dungeon.Contracts" />
    </packageSource>
  </packageSourceMapping>

  <!--
    No token in the repository: NuGet reads both values from the environment.
    GITHUB_PACKAGES_USER is a GitHub user name, GITHUB_PACKAGES_TOKEN a token allowed to
    read packages (a classic personal access token with read:packages on a workstation,
    GITHUB_TOKEN in GitHub Actions).
  -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
